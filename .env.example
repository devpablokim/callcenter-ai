# Local secrets — gitignored, never committed.
# Uncomment and paste your key if you run `npm run genimage` locally.
# (In Claude Code cloud, set OPENAI_API_KEY in the environment settings instead.)
# OPENAI_API_KEY=sk-...

OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# low | medium | high | auto
OPENAI_IMAGE_QUALITY=high
